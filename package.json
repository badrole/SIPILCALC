{
  "name": "sipilcalc-engineering-system",
  "version": "3.0.0",
  "description": "SIPILCALC Engineering System (Structural Concrete Estimation)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "npx http-server -o",
    "build:exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.sipilcalc.app",
    "productName": "SIPILCALC",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "screen.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SIPILCALC"
    },
    "portable": {
      "artifactName": "SIPILCALC-Standalone.exe"
    }
  },
  "keywords": [
    "sipilcalc",
    "kalkulator-beton",
    "rebar-calculator",
    "civil-engineering"
  ],
  "author": "SIPILCALC Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "http-server": "^14.1.1"
  }
}
